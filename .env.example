GITHUB_TOKEN=
GITHUB_OWNER=Void0dev
GITHUB_REPO=harness
GITHUB_BASE_BRANCH=stage
POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_RUNS=1
HEALTH_PORT=3000
# Coolify/container only; leave unset for local repo-relative .harness storage.
# HARNESS_DATA_DIR=/opt/issue-harness/void0dev-harness

# Sandcastle/Codex
CODEX_AUTH_MODE=subscription
OPENAI_API_KEY=
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=high
SANDCASTLE_IMAGE=sandcastle-harness:0.1.0
SANDCASTLE_BUILD_LOCAL=true
REQUIRE_PINNED_IMAGES=false
SANDBOX_REGISTRY_SERVER=
SANDBOX_REGISTRY_USERNAME=
SANDBOX_REGISTRY_TOKEN=

# Optional Coolify/Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud
