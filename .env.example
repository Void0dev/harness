GITHUB_TOKEN=
GITHUB_OWNER=Void0dev
GITHUB_REPO=harness
GITHUB_BASE_BRANCH=stage
POLL_INTERVAL_SECONDS=60
MAX_CONCURRENT_RUNS=1
HEALTH_PORT=3000
# Optional locally; required for online identity verification. Use 32+ random characters.
HARNESS_HEALTH_DETAILS_TOKEN=
# Coolify/container only; leave unset for local repo-relative .harness storage.
# HARNESS_DATA_DIR=/opt/issue-harness/void0dev-harness

# Sandcastle/Codex. Untrusted sandboxes use only short-lived broker tokens;
# never configure OPENAI_API_KEY or a persistent subscription CODEX_HOME here.
CODEX_AUTH_MODE=broker
CODEX_BROKER_URL=http://codex-broker:8080/v1
CODEX_BROKER_AUDIENCE=codex-broker
CODEX_BROKER_SIGNING_SECRET=
CODEX_BROKER_TOKEN_TTL_SECONDS=1800
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=high
SANDCASTLE_IMAGE=sandcastle-harness:0.1.0
SANDBOX_NETWORK=codex-broker-internal
SANDBOX_MEMORY_MB=4096
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_MB=256
SANDBOX_MAX_OUTPUT_BYTES=4194304
SANDCASTLE_BUILD_LOCAL=true
REQUIRE_PINNED_IMAGES=false
SANDBOX_REGISTRY_SERVER=
SANDBOX_REGISTRY_USERNAME=
SANDBOX_REGISTRY_TOKEN=
# Local rootless Docker mode only. Discover once with the dedicated daemon:
# docker --host unix:///run/user/UID/docker.sock info --format '{{.ID}}'
SANDBOX_DOCKER_DAEMON_ID=
DOCKER_HOST=unix:///run/user/1000/docker.sock
SANDBOX_DOCKER_SOCKET=/run/user/1000/docker.sock

# Optional Coolify/Convex
VITE_CONVEX_URL=https://your-deployment.convex.cloud
