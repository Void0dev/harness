{
  "name": "harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/convex-demo",
    "services/issue-harness"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present && npm run test:skills",
    "test:skills": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev:demo": "npm run dev -w apps/convex-demo",
    "dev:harness": "npm run dev -w services/issue-harness"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
